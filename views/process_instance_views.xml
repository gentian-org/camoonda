<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Process Instance Tree View -->
    <record id="view_process_instance_tree" model="ir.ui.view">
        <field name="name">camoonda.process.instance.tree</field>
        <field name="model">camoonda.process.instance</field>
        <field name="arch" type="xml">
            <list string="Process Instances">
                <field name="name"/>
                <field name="business_key"/>
                <field name="process_id"/>
                <field name="state"/>
                <field name="started_by"/>
                <field name="started_date"/>
                <field name="completed_date"/>
            </list>
        </field>
    </record>

    <!-- Process Instance Form View -->
    <record id="view_process_instance_form" model="ir.ui.view">
        <field name="name">camoonda.process.instance.form</field>
        <field name="model">camoonda.process.instance</field>
        <field name="arch" type="xml">
            <form string="Process Instance">
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary" 
                            invisible="('state', '!=', 'ready')"/>
                    <button name="action_suspend" string="Suspend" type="object" 
                            invisible="('state', '!=', 'running')"/>
                    <button name="action_resume" string="Resume" type="object" 
                            invisible="('state', '!=', 'suspended')"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ['completed', 'failed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_incidents"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle"
                                invisible="('incident_count', '=', 0)">
                            <field name="incident_count" widget="statinfo" string="Incidents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Has Incidents" bg_color="bg-danger" invisible="('has_incidents', '=', False)"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="business_key"/>
                            <field name="process_id"/>
                            <field name="process_key"/>
                            <field name="has_incidents" invisible="1"/>
                        </group>
                        <group>
                            <field name="started_by"/>
                            <field name="started_date"/>
                            <field name="completed_date"/>
                        </group>
                    </group>
                    <group string="Related Business Object">
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="res_name"/>
                    </group>
                    <notebook>
                        <page string="Process Variables">
                            <field name="variables_display" widget="ace" options="{'mode': 'json', 'readonly': 1}"/>
                        </page>
                        <page string="Active Tokens">
                            <field name="active_token_ids">
                                <list>
                                    <field name="element_id"/>
                                    <field name="element_type"/>
                                    <field name="state"/>
                                    <field name="arrived_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Execution History">
                            <field name="execution_history_ids">
                                <list>
                                    <field name="execution_date"/>
                                    <field name="element_id"/>
                                    <field name="element_name"/>
                                    <field name="event_type"/>
                                    <field name="details"/>
                                    <field name="executed_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Incidents" invisible="('incident_count', '=', 0)">
                            <field name="incident_ids">
                                <list decoration-danger="state=='created' and severity=='critical'">
                                    <field name="create_date"/>
                                    <field name="incident_type"/>
                                    <field name="element_id"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Process Instance Search View -->
    <record id="view_process_instance_search" model="ir.ui.view">
        <field name="name">camoonda.process.instance.search</field>
        <field name="model">camoonda.process.instance</field>
        <field name="arch" type="xml">
            <search string="Search Process Instances">
                <field name="name"/>
                <field name="business_key"/>
                <field name="process_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="With Incidents" name="with_incidents" domain="[('has_incidents', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Process Definition" name="group_process" context="{'group_by': 'process_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Business Key" name="group_business_key" context="{'group_by': 'business_key'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Process Instance Action -->
    <record id="action_process_instance" model="ir.actions.act_window">
        <field name="name">Process Instances</field>
        <field name="res_model">camoonda.process.instance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No process instances yet
            </p>
            <p>
                Process instances are individual executions of process definitions.
            </p>
        </field>
    </record>
</odoo>
